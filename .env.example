# Supabase (local: npx supabase start → npx supabase status -o env)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google Maps Platform — enable Maps JavaScript API, Solar API, Geocoding API,
# Places API, and Maps Static API (PDF roof map export)
# Prefer restricting NEXT_PUBLIC_* by HTTP referrer in production.
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# LLM for county / permit resource lookups (Vercel AI SDK)
# Prefer OpenRouter when set; otherwise Google AI Studio with GEMINI_API_KEY.
# Model default: google/gemini-3.5-flash-lite (OpenRouter) or gemini-3.5-flash-lite (Google)
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# OPENROUTER_MODEL=google/gemini-3.5-flash-lite
# GEMINI_MODEL=gemini-3.5-flash-lite

# Power-bill parsing uses Gemini 3.5 Flash by default (override separately).
# OPENROUTER_BILL_MODEL=google/gemini-3.5-flash
# GEMINI_BILL_MODEL=gemini-3.5-flash

# Service role — required for background bill processing (download + status writes)
SUPABASE_SERVICE_ROLE_KEY=
# Optional dedicated secret for Netlify background → process API auth
# BILL_PROCESS_SECRET=

# Supabase CLI (migrations push)
# SUPABASE_ACCESS_TOKEN=

# Canonical site URL for metadata, Open Graph, sitemap, and robots.
# Production example: https://solarflow.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe — when STRIPE_SECRET_KEY is set, HOA package checkout ($29.97 / project) is available.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Resend — transactional email when Solar bot replies and the user is away.
# RESEND_API_KEY=
# EMAIL_FROM=SolarFlow <onboarding@resend.dev>

# Optional dedicated secret for Netlify background HOA document processing
# HOA_PROCESS_SECRET=
